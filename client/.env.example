# URL of the Blood Bank API (the /api/v1 door of the server)
VITE_API_URL=http://localhost:8080/api/v1

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: turns on Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# How people sign in: "otp" (SMS code, the default) or "direct" (phone number only, no code).
# "direct" needs ALLOW_PHONE_LOGIN=true on the server and is ignored in production builds.
# VITE_AUTH_MODE=otp

# Countries the sign-in SMS may go to, comma separated. Must also be allowed in
# Firebase > Authentication > Settings > SMS region policy.
VITE_SMS_COUNTRIES=IN

# DEVELOPMENT ONLY. Skips reCAPTCHA for the "Phone numbers for testing" in Firebase. Ignored in production builds.
# VITE_DISABLE_APP_VERIFICATION=true

# Google Cloud console > APIs & Services > Credentials. Enable "Maps JavaScript API" for this key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a map ID from Google Maps Platform > Map management (defaults to Google's DEMO_MAP_ID)
# VITE_GOOGLE_MAPS_MAP_ID=
