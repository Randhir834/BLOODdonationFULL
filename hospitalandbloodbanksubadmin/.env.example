# URL of the Blood Bank API's hospital and blood bank door
VITE_API_URL=http://localhost:8080/api/org

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
# (the same web app the mobile app uses: a hospital or blood bank has one account for both)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# How people sign in: "otp" (SMS code, the default) or "direct" (phone number only, no code).
# "direct" needs ALLOW_PHONE_LOGIN=true on the server and is ignored in production builds.
# VITE_AUTH_MODE=otp

# Countries the sign-in SMS may go to, comma separated. Must also be allowed in
# Firebase > Authentication > Settings > SMS region policy.
VITE_SMS_COUNTRIES=IN

# DEVELOPMENT ONLY. Skips reCAPTCHA for the "Phone numbers for testing" in Firebase. Ignored in production builds.
# VITE_DISABLE_APP_VERIFICATION=true
