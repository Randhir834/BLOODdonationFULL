{
  "name": "blood-bank-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Website for hospitals and blood banks to register and manage their blood stock and blood requests (React + Vite + Firebase Auth)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
