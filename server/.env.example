# --- Server ---
NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info

# Website origin(s) allowed to call each API from a browser, comma separated. Required in production.
CLIENT_ORIGIN=http://localhost:3100
ADMIN_ORIGIN=http://localhost:3101
# Only behind a reverse proxy / load balancer: how many proxies sit in front of the server (usually 1).
# TRUST_PROXY=1

# --- Firebase Admin credentials (first one set wins) ---
# 1. The whole service account JSON as one line (for hosts where you can not ship a file)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Path to the service account key file, relative to this folder (never commit the key)
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/serviceAccountKey.json
# 3. Neither set: Application Default Credentials (Cloud Run, GCE, `gcloud auth application-default login`)

# --- Admin dashboard ---
# Time zone the dashboard uses for "today" and the daily chart (IANA name)
ADMIN_TIMEZONE=UTC
# A blood group with less than this many ML in stock is flagged as low
LOW_STOCK_ML=1000
# Organisations and hospitals with no blood movement for this many days are flagged inactive
INACTIVE_DAYS=30
# How long a blood unit may be stored before it expires (days). 42 is the usual shelf life of
# whole blood / packed red cells stored refrigerated; adjust if you store other components.
SHELF_LIFE_DAYS=42
# A unit expiring within this many days is flagged to the blood bank and the admin dashboard
EXPIRY_WARNING_DAYS=7

# --- Development only ---
# Lets a phone number sign in with no OTP: anyone who knows a number can sign in as it.
# The server refuses to start with this enabled when NODE_ENV=production.
# ALLOW_PHONE_LOGIN=true
