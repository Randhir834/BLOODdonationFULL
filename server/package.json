{
  "name": "blood-bank-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Blood Bank apps (Express + Firebase Admin)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-admin": "node scripts/createAdmin.js",
    "rebuild-stock": "node scripts/rebuildStock.js",
    "migrate-units": "node scripts/migrateToUnits.js",
    "sweep-expired": "node scripts/sweepExpiredUnits.js"
  },
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
