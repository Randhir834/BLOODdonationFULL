# URL of the Blood Bank API (the /api/admin door of the server)
VITE_API_URL=http://localhost:8080/api/admin

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Not read by src/lib/firebase.js today, kept here only so the example matches everything the Firebase
# console gives you; safe to leave blank.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Cloud console > APIs & Services > Credentials. Enable "Maps JavaScript API" for this key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a map ID from Google Maps Platform > Map management (defaults to Google's DEMO_MAP_ID)
# VITE_GOOGLE_MAPS_MAP_ID=
